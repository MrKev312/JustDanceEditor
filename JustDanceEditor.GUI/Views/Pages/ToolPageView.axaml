<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="using:JustDanceEditor.GUI.ViewModels.Pages"
             x:Class="JustDanceEditor.GUI.Views.Pages.ToolPageView"
             x:DataType="pages:ToolPageViewModel">
  <StackPanel Spacing="12">
    <TextBlock Classes="sectionTitle" Text="{Binding TitleText}" />
    <TextBlock Classes="muted" Text="{Binding DescriptionText}" TextWrapping="Wrap" />
    <ItemsControl ItemsSource="{Binding Prompts}">
      <ItemsControl.ItemsPanel>
        <ItemsPanelTemplate>
          <StackPanel Spacing="8" />
        </ItemsPanelTemplate>
      </ItemsControl.ItemsPanel>
    </ItemsControl>
  </StackPanel>
</UserControl>
