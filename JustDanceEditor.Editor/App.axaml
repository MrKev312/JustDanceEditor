<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="JustDanceEditor.Editor.App"
			 xmlns:local="clr-namespace:JustDanceEditor.Editor"
             xmlns:dock="using:Dock.Avalonia.Controls"
             RequestedThemeVariant="Dark">
	<!-- "Default" ThemeVariant follows system theme. "Dark" or "Light" are other available options. -->

	<Application.Resources>
		<!-- Dock 12 themes the Avalonia 12 window-decoration underlay; keep that layer transparent so Windows Mica remains visible. -->
		<SolidColorBrush x:Key="DockWindowChromeBackgroundBrush" Color="#00000000" />
		<SolidColorBrush x:Key="DockWindowChromeTitleBarBackgroundBrush" Color="#00000000" />
		<SolidColorBrush x:Key="DockWindowChromeForegroundBrush" Color="#FFFFFFFF" />
		<x:Double x:Key="DockCaptionButtonWidth">46</x:Double>
		<x:Double x:Key="DockCaptionButtonHeight">32</x:Double>
	</Application.Resources>

	<Application.Styles>
		<FluentTheme>
			<FluentTheme.Palettes>
				<ColorPaletteResources x:Key="Dark"
										Accent="#8B5CF6"
										RegionColor="#662A2433"
										ChromeLow="#662A2433"
										ChromeMediumLow="#80302A39"
										ChromeMedium="#99372E42"
										ChromeHigh="#B05E5866" />
			</FluentTheme.Palettes>
		</FluentTheme>
		<DockFluentTheme />
		<StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
		<StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

		<Style Selector="dock|DockControl, dock|RootDockControl, dock|DocumentDockControl, dock|DocumentControl, dock|ToolDockControl, dock|ToolControl, dock|ProportionalDockControl, dock|StackDockControl, dock|GridDockControl, dock|SplitViewDockControl">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="dock|DocumentContentControl, dock|ToolContentControl">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="dock|DocumentTabStrip, dock|ToolTabStrip, dock|DocumentTabStripItem, dock|ToolTabStripItem">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="dock|DockControl Border">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="dock|DockControl Panel">
			<Setter Property="Background" Value="Transparent" />
		</Style>
		<Style Selector="dock|DockControl ContentControl">
			<Setter Property="Background" Value="Transparent" />
		</Style>
	</Application.Styles>

	<Application.DataTemplates>
		<local:ViewLocator />
	</Application.DataTemplates>
	
</Application>
