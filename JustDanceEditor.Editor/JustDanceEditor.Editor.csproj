<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<RuntimeIdentifiers>win-x64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
		<LangVersion>Preview</LangVersion>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Include="Layouts\DefaultLayout.json" Condition="Exists('Layouts\DefaultLayout.json')" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Desktop" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="$(AvaloniaVersion)" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="$(AvaloniaVersion)" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<!-- Dock Packages -->
		<PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
		<PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
		<PackageReference Include="Dock.Serializer" Version="11.3.0.12" />
		<PackageReference Include="KevInc.Avalonia" Version="$(KevIncAvaloniaPackageVersion)" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAvaloniaProject)')" />
		<PackageReference Include="KevInc.Avalonia.Dock" Version="$(KevIncAvaloniaPackageVersion)" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAvaloniaDockProject)')" />
		<PackageReference Include="KevInc.Avalonia.Timeline" Version="$(KevIncAvaloniaPackageVersion)" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAvaloniaTimelineProject)')" />
		<PackageReference Include="KevInc.Audio.NAudio" Version="$(KevIncAudioPackageVersion)" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAudioNAudioProject)')" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.8" />
		<PackageReference Include="Concentus" Version="2.2.2" />
		<PackageReference Include="Concentus.OggFile" Version="1.0.7" />
		<PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="PortAudioSharp2" Version="1.0.6" />
		<PackageReference Include="SkiaSharp" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="SkiaSharp.NativeAssets.macOS" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="$(SkiaSharpVersion)" />
		<PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
		<PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
	</ItemGroup>

	<ItemGroup>
	  <KevIncLocalProjectReference Include="$(KevIncAvaloniaProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAvaloniaProject)')" />
	  <KevIncLocalProjectReference Include="$(KevIncAvaloniaDockProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAvaloniaDockProject)')" />
	  <KevIncLocalProjectReference Include="$(KevIncAvaloniaTimelineProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAvaloniaTimelineProject)')" />
	  <KevIncLocalProjectReference Include="$(KevIncAudioNAudioProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAudioNAudioProject)')" />
	  <ProjectReference Include="..\JustDanceEditor.Formats.JDI\JustDanceEditor.Formats.JDI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\Tools\PropertiesToolView.axaml.cs">
			<DependentUpon>PropertiesToolView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\LibraryToolView.axaml.cs">
			<DependentUpon>LibraryToolView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>
</Project>
