<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<LangVersion>Preview</LangVersion>
		<Nullable>enable</Nullable>
		<BuiltInComInteropSupport>true</BuiltInComInteropSupport>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
	</PropertyGroup>

	<ItemGroup>
		<AvaloniaResource Include="Assets\**" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Avalonia" Version="12.0.2" />
		<PackageReference Include="Avalonia.Controls.ColorPicker" Version="12.0.2" />
		<PackageReference Include="Avalonia.Desktop" Version="12.0.2" />
		<PackageReference Include="Avalonia.Themes.Fluent" Version="12.0.2" />
		<PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.2" />
		<PackageReference Include="Avalonia.Controls.DataGrid" Version="12.0.0" />
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />

		<!-- Dock Packages -->
		<PackageReference Include="Dock.Avalonia" Version="12.0.0.2" />
		<PackageReference Include="Dock.Model.Mvvm" Version="12.0.0.2" />
		<PackageReference Include="Dock.Avalonia.Themes.Fluent" Version="12.0.0.2" />
		<PackageReference Include="Dock.Serializer" Version="11.3.0.12" />
		<PackageReference Include="KevInc.Avalonia" Version="0.1.3" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAvaloniaProject)')" />
		<PackageReference Include="KevInc.Avalonia.Dock" Version="0.1.3" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAvaloniaDockProject)')" />
		<PackageReference Include="KevInc.Avalonia.Timeline" Version="0.1.3" Condition="'$(UseLocalKevIncProjects)' != 'true' Or !Exists('$(KevIncAvaloniaTimelineProject)')" />
		<PackageReference Include="LibVLCSharp" Version="3.9.7.1" />
		<PackageReference Include="LibVLCSharp.Avalonia" Version="3.9.7.1" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.7" />
                <PackageReference Include="NAudio" Version="2.3.0" />
		<PackageReference Include="VideoLAN.LibVLC.Windows" Version="3.0.23.1" />
		<PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="$(KevIncAvaloniaProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAvaloniaProject)')" />
	  <ProjectReference Include="$(KevIncAvaloniaDockProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAvaloniaDockProject)')" />
	  <ProjectReference Include="$(KevIncAvaloniaTimelineProject)" Condition="'$(UseLocalKevIncProjects)' == 'true' And Exists('$(KevIncAvaloniaTimelineProject)')" />
	  <ProjectReference Include="..\JustDanceEditor.Audio\JustDanceEditor.Audio.csproj" />
	  <ProjectReference Include="..\JustDanceEditor.Formats.JDI\JustDanceEditor.Formats.JDI.csproj" />
	</ItemGroup>

	<ItemGroup>
		<Compile Update="Views\Tools\PropertiesToolView.axaml.cs">
			<DependentUpon>PropertiesToolView.axaml</DependentUpon>
		</Compile>
		<Compile Update="Views\Tools\LibraryToolView.axaml.cs">
			<DependentUpon>LibraryToolView.axaml</DependentUpon>
		</Compile>
	</ItemGroup>
</Project>
