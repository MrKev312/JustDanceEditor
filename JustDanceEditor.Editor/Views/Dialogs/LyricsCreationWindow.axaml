<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:JustDanceEditor.Editor.ViewModels.Dialogs;assembly=JustDanceEditor.Editor"
        x:Class="JustDanceEditor.Editor.Views.Dialogs.LyricsCreationWindow"
        x:DataType="vm:LyricsCreationViewModel"
        Title="Add Lyrics"
        Width="420"
        SizeToContent="Height"
        CanResize="False"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="6">
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="120"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <TextBlock Grid.Row="0" Grid.Column="0" VerticalAlignment="Center" Text="Lyrics:"/>
    <TextBox Grid.Row="0" Grid.Column="1" Width="260" Text="{Binding Lyrics, Mode=TwoWay}"/>

    <TextBlock Grid.Row="1" Grid.Column="0" VerticalAlignment="Center" Text="Duration (beats):"/>
    <NumericUpDown Grid.Row="1" Grid.Column="1" Width="120" Value="{Binding DurationBeats, Mode=TwoWay}"/>

    <CheckBox Grid.Row="2" Grid.Column="1" Content="End of line" IsChecked="{Binding IsEndOfLine, Mode=TwoWay}"/>

    <StackPanel Grid.Row="3" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Name="OkBtn" Margin="6">OK</Button>
      <Button Name="CancelBtn" Margin="6">Cancel</Button>
    </StackPanel>
  </Grid>
</Window>