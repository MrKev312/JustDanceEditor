<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:JustDanceEditor.Editor.ViewModels.Tools"
             x:Class="JustDanceEditor.Editor.Views.Tools.WorldToolView"
             x:DataType="vm:WorldToolViewModel">
    <StackPanel Margin="20">
        <TextBlock Text="Welcome to the World Component" FontSize="20" FontWeight="Bold"/>
        <TextBlock Text="{Binding Message}" Margin="0,10,0,0" />
    </StackPanel>
</UserControl>