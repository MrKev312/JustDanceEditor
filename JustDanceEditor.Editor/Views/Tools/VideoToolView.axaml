<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:JustDanceEditor.Editor.ViewModels.Tools"
             xmlns:tools="clr-namespace:JustDanceEditor.Editor.Views.Tools"
             x:Class="JustDanceEditor.Editor.Views.Tools.VideoToolView"
             x:DataType="vm:VideoToolViewModel">
	<Panel Background="Black">
		<tools:VideoFrameControl Source="{Binding CurrentFrame}"
                                  FrameVersion="{Binding CurrentFrameVersion}"
                                  IsVisible="{Binding CurrentFrame, Converter={x:Static ObjectConverters.IsNotNull}}" />

		<TextBlock Text="{Binding VideoStatusText}"
                   IsVisible="{Binding CurrentFrame, Converter={x:Static ObjectConverters.IsNull}}"
                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
	</Panel>
</UserControl>
