<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <UseLocalKevIncProjects Condition="'$(UseLocalKevIncProjects)' == ''">true</UseLocalKevIncProjects>
    <KevIncReposRoot Condition="'$(KevIncReposRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..'))</KevIncReposRoot>
    <KevIncLocalTargetFramework Condition="'$(KevIncLocalTargetFramework)' == ''">net10.0</KevIncLocalTargetFramework>
    <AvaloniaVersion>12.1.1</AvaloniaVersion>
    <AvaloniaDataGridVersion>12.1.2</AvaloniaDataGridVersion>
    <SkiaSharpVersion>4.151.0</SkiaSharpVersion>

    <KevIncAvaloniaRoot Condition="'$(KevIncAvaloniaRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(KevIncReposRoot)', 'KevInc.Avalonia'))</KevIncAvaloniaRoot>
    <KevIncAvaloniaPackageVersion>0.2.6</KevIncAvaloniaPackageVersion>
    <KevIncAvaloniaProject>$(KevIncAvaloniaRoot)src\KevInc.Avalonia\KevInc.Avalonia.csproj</KevIncAvaloniaProject>
    <KevIncAvaloniaDockProject>$(KevIncAvaloniaRoot)src\KevInc.Avalonia.Dock\KevInc.Avalonia.Dock.csproj</KevIncAvaloniaDockProject>
    <KevIncAvaloniaTimelineProject>$(KevIncAvaloniaRoot)src\KevInc.Avalonia.Timeline\KevInc.Avalonia.Timeline.csproj</KevIncAvaloniaTimelineProject>

    <KevIncAudioRoot Condition="'$(KevIncAudioRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(KevIncReposRoot)', 'KevInc.Audio'))</KevIncAudioRoot>
    <KevIncAudioPackageVersion>0.2.3</KevIncAudioPackageVersion>
    <KevIncAudioCafeProject>$(KevIncAudioRoot)src\KevInc.Audio.Cafe\KevInc.Audio.Cafe.csproj</KevIncAudioCafeProject>
    <KevIncAudioNxProject>$(KevIncAudioRoot)src\KevInc.Audio.Nx\KevInc.Audio.Nx.csproj</KevIncAudioNxProject>
    <KevIncAudioNAudioProject>$(KevIncAudioRoot)src\KevInc.Audio.NAudio\KevInc.Audio.NAudio.csproj</KevIncAudioNAudioProject>
    <KevIncAudioCafeNAudioProject>$(KevIncAudioRoot)src\KevInc.Audio.Cafe.NAudio\KevInc.Audio.Cafe.NAudio.csproj</KevIncAudioCafeNAudioProject>
    <KevIncAudioNxNAudioProject>$(KevIncAudioRoot)src\KevInc.Audio.Nx.NAudio\KevInc.Audio.Nx.NAudio.csproj</KevIncAudioNxNAudioProject>
    <KevIncAudioXma2Project>$(KevIncAudioRoot)src\KevInc.Audio.Xma2\KevInc.Audio.Xma2.csproj</KevIncAudioXma2Project>
    <KevIncAudioXma2NAudioProject>$(KevIncAudioRoot)src\KevInc.Audio.Xma2.NAudio\KevInc.Audio.Xma2.NAudio.csproj</KevIncAudioXma2NAudioProject>

    <KevIncTextureRoot Condition="'$(KevIncTextureRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(KevIncReposRoot)', 'KevInc.Texture'))</KevIncTextureRoot>
    <KevIncTexturePackageVersion>0.2.3</KevIncTexturePackageVersion>
    <KevIncCrnLibProject>$(KevIncTextureRoot)src\KevInc.CrnLib\KevInc.CrnLib.csproj</KevIncCrnLibProject>
    <KevIncCrnLibImageSharpProject>$(KevIncTextureRoot)src\KevInc.CrnLib.ImageSharp\KevInc.CrnLib.ImageSharp.csproj</KevIncCrnLibImageSharpProject>
    <KevIncTextureProject>$(KevIncTextureRoot)src\KevInc.Texture\KevInc.Texture.csproj</KevIncTextureProject>
    <KevIncTextureImageSharpProject>$(KevIncTextureRoot)src\KevInc.Texture.ImageSharp\KevInc.Texture.ImageSharp.csproj</KevIncTextureImageSharpProject>
    <KevIncTextureNintendoProject>$(KevIncTextureRoot)src\KevInc.Texture.Nintendo\KevInc.Texture.Nintendo.csproj</KevIncTextureNintendoProject>
    <KevIncTextureNintendoImageSharpProject>$(KevIncTextureRoot)src\KevInc.Texture.Nintendo.ImageSharp\KevInc.Texture.Nintendo.ImageSharp.csproj</KevIncTextureNintendoImageSharpProject>
    <KevIncTexturePlayStationProject>$(KevIncTextureRoot)src\KevInc.Texture.PlayStation\KevInc.Texture.PlayStation.csproj</KevIncTexturePlayStationProject>
    <KevIncTexturePlayStationImageSharpProject>$(KevIncTextureRoot)src\KevInc.Texture.PlayStation.ImageSharp\KevInc.Texture.PlayStation.ImageSharp.csproj</KevIncTexturePlayStationImageSharpProject>
    <KevIncTextureXboxProject>$(KevIncTextureRoot)src\KevInc.Texture.Xbox\KevInc.Texture.Xbox.csproj</KevIncTextureXboxProject>
    <KevIncTextureXboxImageSharpProject>$(KevIncTextureRoot)src\KevInc.Texture.Xbox.ImageSharp\KevInc.Texture.Xbox.ImageSharp.csproj</KevIncTextureXboxImageSharpProject>

    <KevIncUbiArtRoot Condition="'$(KevIncUbiArtRoot)' == ''">$([MSBuild]::NormalizeDirectory('$(KevIncReposRoot)', 'KevInc.UbiArt'))</KevIncUbiArtRoot>
    <KevIncUbiArtPackageVersion>0.2.5</KevIncUbiArtPackageVersion>
    <KevIncUbiArtIpkProject>$(KevIncUbiArtRoot)src\KevInc.UbiArt.Ipk\KevInc.UbiArt.Ipk.csproj</KevIncUbiArtIpkProject>
    <KevIncUbiArtFileSystemProject>$(KevIncUbiArtRoot)src\KevInc.UbiArt.FileSystem\KevInc.UbiArt.FileSystem.csproj</KevIncUbiArtFileSystemProject>
    <KevIncUbiArtRakiProject>$(KevIncUbiArtRoot)src\KevInc.UbiArt.Raki\KevInc.UbiArt.Raki.csproj</KevIncUbiArtRakiProject>
    <KevIncUbiArtTextureProject>$(KevIncUbiArtRoot)src\KevInc.UbiArt.Texture\KevInc.UbiArt.Texture.csproj</KevIncUbiArtTextureProject>
    <KevIncUbiArtCinematicsProject>$(KevIncUbiArtRoot)src\KevInc.UbiArt.Cinematics\KevInc.UbiArt.Cinematics.csproj</KevIncUbiArtCinematicsProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Nerdbank.GitVersioning">
      <PrivateAssets>all</PrivateAssets>
      <Version>3.10.91</Version>
    </PackageReference>
  </ItemGroup>
</Project>
