<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                              Accent="#8B5CF6"
                              RegionColor="#662A2433"
                              ChromeLow="#662A2433"
                              ChromeMediumLow="#80302A39"
                              ChromeMedium="#99372E42"
                              ChromeHigh="#B05E5866" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />
  <StyleInclude Source="avares://KevInc.Avalonia/Styles/MicaWindowChrome.axaml" />

  <Styles.Resources>
    <SolidColorBrush x:Key="JdeWindowBackgroundBrush" Color="#00000000" />
    <SolidColorBrush x:Key="JdeWindowFallbackBrush" Color="#2F2F2F" />
    <SolidColorBrush x:Key="JdeSurfaceBrush" Color="#00000000" />
    <SolidColorBrush x:Key="JdeSurfaceBorderBrush" Color="#445E5866" />
    <SolidColorBrush x:Key="JdeTextPrimaryBrush" Color="#FFFFFFFF" />
    <SolidColorBrush x:Key="JdeTextSecondaryBrush" Color="#FFD9D2E5" />
    <SolidColorBrush x:Key="JdeTextMutedBrush" Color="#FFB8B0C6" />
    <SolidColorBrush x:Key="JdeInputBrush" Color="#0EFFFFFF" />
    <SolidColorBrush x:Key="JdeInputHoverBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="JdeInputFocusBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="JdeInputBorderBrush" Color="#36FFFFFF" />
    <SolidColorBrush x:Key="JdeInputHoverBorderBrush" Color="#42FFFFFF" />
    <SolidColorBrush x:Key="JdeInputFocusBorderBrush" Color="#668B5CF6" />
    <SolidColorBrush x:Key="JdeButtonBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonHoverBrush" Color="#20FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonPressedBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonBorderBrush" Color="#36FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonHoverBorderBrush" Color="#4AFFFFFF" />
    <SolidColorBrush x:Key="JdeAccentBrush" Color="#FF8B5CF6" />
    <SolidColorBrush x:Key="JdeBadgeBrush" Color="#18FFFFFF" />
    <SolidColorBrush x:Key="JdeBadgeBorderBrush" Color="#44FFFFFF" />
    <SolidColorBrush x:Key="JdeListHoverBrush" Color="#14FFFFFF" />
    <Thickness x:Key="JdeMainWindowTitleBarContentMargin">0</Thickness>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource JdeWindowBackgroundBrush}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource JdeWindowFallbackBrush}" />
    <Setter Property="FontFamily" Value="Segoe UI, Inter" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Window[WindowState=Maximized]">
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource JdeButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JdeTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource JdeButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeButtonHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{DynamicResource JdeInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JdeTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover, ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource JdeInputHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus, ComboBox:focus">
    <Setter Property="Background" Value="{DynamicResource JdeInputFocusBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputFocusBorderBrush}" />
  </Style>
</Styles>
