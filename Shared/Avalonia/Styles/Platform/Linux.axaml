<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                              Accent="#4A90D9"
                              RegionColor="#FF20242A"
                              ChromeLow="#FF20242A"
                              ChromeMediumLow="#FF252A31"
                              ChromeMedium="#FF2B313A"
                              ChromeHigh="#FF3D4652" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

  <Styles.Resources>
    <SolidColorBrush x:Key="JdeWindowBackgroundBrush" Color="#20242A" />
    <SolidColorBrush x:Key="JdeWindowFallbackBrush" Color="#20242A" />
    <SolidColorBrush x:Key="JdeSurfaceBrush" Color="#FF252A31" />
    <SolidColorBrush x:Key="JdeSurfaceBorderBrush" Color="#FF3A424D" />
    <SolidColorBrush x:Key="JdeTextPrimaryBrush" Color="#FFF2F5F8" />
    <SolidColorBrush x:Key="JdeTextSecondaryBrush" Color="#FFD8DEE6" />
    <SolidColorBrush x:Key="JdeTextMutedBrush" Color="#FFADB7C3" />
    <SolidColorBrush x:Key="JdeInputBrush" Color="#FF1C2026" />
    <SolidColorBrush x:Key="JdeInputHoverBrush" Color="#FF232932" />
    <SolidColorBrush x:Key="JdeInputFocusBrush" Color="#FF252D38" />
    <SolidColorBrush x:Key="JdeInputBorderBrush" Color="#FF3D4652" />
    <SolidColorBrush x:Key="JdeInputHoverBorderBrush" Color="#FF4B5664" />
    <SolidColorBrush x:Key="JdeInputFocusBorderBrush" Color="#CC4A90D9" />
    <SolidColorBrush x:Key="JdeButtonBrush" Color="#FF2B313A" />
    <SolidColorBrush x:Key="JdeButtonHoverBrush" Color="#FF343C47" />
    <SolidColorBrush x:Key="JdeButtonPressedBrush" Color="#FF252B34" />
    <SolidColorBrush x:Key="JdeButtonBorderBrush" Color="#FF46515F" />
    <SolidColorBrush x:Key="JdeButtonHoverBorderBrush" Color="#FF596676" />
    <SolidColorBrush x:Key="JdeAccentBrush" Color="#FF4A90D9" />
    <SolidColorBrush x:Key="JdeBadgeBrush" Color="#FF2B313A" />
    <SolidColorBrush x:Key="JdeBadgeBorderBrush" Color="#FF46515F" />
    <SolidColorBrush x:Key="JdeListHoverBrush" Color="#FF2E3540" />
    <Thickness x:Key="JdeMainWindowTitleBarContentMargin">0</Thickness>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource JdeWindowBackgroundBrush}" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource JdeWindowFallbackBrush}" />
    <Setter Property="FontFamily" Value="Cantarell, Noto Sans, Inter" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Window[WindowState=Maximized]">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button, TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource JdeButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JdeTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource JdeButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeButtonHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{DynamicResource JdeInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JdeTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover, ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource JdeInputHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus, ComboBox:focus">
    <Setter Property="Background" Value="{DynamicResource JdeInputFocusBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputFocusBorderBrush}" />
  </Style>
</Styles>
