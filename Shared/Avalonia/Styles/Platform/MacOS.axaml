<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <FluentTheme>
    <FluentTheme.Palettes>
      <ColorPaletteResources x:Key="Dark"
                              Accent="#0A84FF"
                              RegionColor="#4A111114"
                              ChromeLow="#5C151518"
                              ChromeMediumLow="#781C1C20"
                              ChromeMedium="#9126262B"
                              ChromeHigh="#F2F7FAFF" />
    </FluentTheme.Palettes>
  </FluentTheme>
  <StyleInclude Source="avares://Avalonia.Controls.ColorPicker/Themes/Fluent/Fluent.xaml" />
  <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Fluent.xaml" />

  <Styles.Resources>
    <SolidColorBrush x:Key="JdeWindowBackgroundBrush" Color="#52101012" />
    <SolidColorBrush x:Key="JdeWindowFallbackBrush" Color="#171719" />
    <SolidColorBrush x:Key="JdeSurfaceBrush" Color="#781C1C20" />
    <SolidColorBrush x:Key="JdeSurfaceBorderBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="JdeTextPrimaryBrush" Color="#FFF7FAFF" />
    <SolidColorBrush x:Key="JdeTextSecondaryBrush" Color="#E6EAF2FF" />
    <SolidColorBrush x:Key="JdeTextMutedBrush" Color="#C8D8DEE8" />
    <SolidColorBrush x:Key="JdeInputBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="JdeInputHoverBrush" Color="#4CFFFFFF" />
    <SolidColorBrush x:Key="JdeInputFocusBrush" Color="#5CFFFFFF" />
    <SolidColorBrush x:Key="JdeInputBorderBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="JdeInputHoverBorderBrush" Color="#73FFFFFF" />
    <SolidColorBrush x:Key="JdeInputFocusBorderBrush" Color="#AA64D2FF" />
    <SolidColorBrush x:Key="JdeButtonBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonHoverBrush" Color="#4DFFFFFF" />
    <SolidColorBrush x:Key="JdeButtonPressedBrush" Color="#26FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonBorderBrush" Color="#59FFFFFF" />
    <SolidColorBrush x:Key="JdeButtonHoverBorderBrush" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="JdeAccentBrush" Color="#FF0A84FF" />
    <SolidColorBrush x:Key="JdeBadgeBrush" Color="#3DFFFFFF" />
    <SolidColorBrush x:Key="JdeBadgeBorderBrush" Color="#66FFFFFF" />
    <SolidColorBrush x:Key="JdeListHoverBrush" Color="#2EFFFFFF" />
    <Thickness x:Key="JdeMainWindowTitleBarContentMargin">76,0,0,0</Thickness>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="TransparencyBackgroundFallback" Value="{DynamicResource JdeWindowFallbackBrush}" />
    <Setter Property="FontFamily" Value=".AppleSystemUIFont, SF Pro Text, Inter" />
    <Setter Property="Padding" Value="0" />
  </Style>
  <Style Selector="Window[WindowState=Maximized]">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Button, TextBox, ComboBox">
    <Setter Property="CornerRadius" Value="10" />
  </Style>
  <Style Selector="Button">
    <Setter Property="Background" Value="{DynamicResource JdeButtonBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeButtonBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JdeTextPrimaryBrush}" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Background" Value="{DynamicResource JdeButtonHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeButtonHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox, ComboBox">
    <Setter Property="Background" Value="{DynamicResource JdeInputBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputBorderBrush}" />
    <Setter Property="Foreground" Value="{DynamicResource JdeTextPrimaryBrush}" />
  </Style>
  <Style Selector="TextBox:pointerover, ComboBox:pointerover">
    <Setter Property="Background" Value="{DynamicResource JdeInputHoverBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputHoverBorderBrush}" />
  </Style>
  <Style Selector="TextBox:focus, ComboBox:focus">
    <Setter Property="Background" Value="{DynamicResource JdeInputFocusBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource JdeInputFocusBorderBrush}" />
  </Style>
</Styles>
